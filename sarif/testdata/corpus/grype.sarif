  "runs": [
    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.110.0",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "GO-2026-4918-golang.org/x/net",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "GO-2026-4918 high vulnerability for golang.org/x/net package"
              },
              "fullDescription": {
                "text": "When processing HTTP/2 SETTINGS frames, transport will enter an infinite loop of writing CONTINUATION frames if it receives a SETTINGS_MAX_FRAME_SIZE with a value of 0."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability GO-2026-4918\nSeverity: high\nPackage: golang.org/x/net\nVersion: v0.52.0\nFix Version: 0.53.0\nType: go-module\nLocation: /api/go.mod\nData Namespace: govulndb:language:go\nLink: [GO-2026-4918](https://go.dev/cl/761581)",
                "markdown": "**Vulnerability GO-2026-4918**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | golang.org/x/net  | v0.52.0  | 0.53.0  | go-module  | /api/go.mod  | govulndb:language:go  | [GO-2026-4918](https://go.dev/cl/761581)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:golang/golang.org/x/net@v0.52.0"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "GO-2026-5026-golang.org/x/net",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "GO-2026-5026 high vulnerability for golang.org/x/net package"
              },
              "fullDescription": {
                "text": "The ToASCII and ToUnicode functions incorrectly accept Punycode-encoded labels that decode to an ASCII-only label. For example, ToUnicode(\"xn--example-.com\") incorrectly returns the name \"example.com\" rather than an error.\n\nThis behavior can lead to privilege escalation in programs using the idna package. For example, a program which performs privilege checks on the ASCII hostname may reject \"example.com\" but permit \"xn--example-.com\". If that program subsequently converts the ASCII hostname to Unicode, it will inadvertently permits access to the Unicode name \"example.com\"."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability GO-2026-5026\nSeverity: high\nPackage: golang.org/x/net\nVersion: v0.52.0\nFix Version: 0.55.0\nType: go-module\nLocation: /api/go.mod\nData Namespace: govulndb:language:go\nLink: [GO-2026-5026](https://go.dev/cl/767220)",
                "markdown": "**Vulnerability GO-2026-5026**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | golang.org/x/net  | v0.52.0  | 0.55.0  | go-module  | /api/go.mod  | govulndb:language:go  | [GO-2026-5026](https://go.dev/cl/767220)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:golang/golang.org/x/net@v0.52.0"
                ],
                "security-severity": "8.2"
              }
            },
            {
              "id": "GO-2026-5970-golang.org/x/text",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "GO-2026-5970 high vulnerability for golang.org/x/text package"
              },
              "fullDescription": {
                "text": "A norm.Iter can enter an infinite loop when handling input containing invalid UTF-8 bytes."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability GO-2026-5970\nSeverity: high\nPackage: golang.org/x/text\nVersion: v0.38.0\nFix Version: 0.39.0\nType: go-module\nLocation: /api/go.mod\nData Namespace: govulndb:language:go\nLink: [GO-2026-5970](https://go.dev/issue/80142)",
                "markdown": "**Vulnerability GO-2026-5970**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| high  | golang.org/x/text  | v0.38.0  | 0.39.0  | go-module  | /api/go.mod  | govulndb:language:go  | [GO-2026-5970](https://go.dev/issue/80142)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:golang/golang.org/x/text@v0.38.0"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "GO-2026-5942-golang.org/x/net",
              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "GO-2026-5942 high vulnerability for golang.org/x/net package"
              },
              "fullDescription": {
                "text": "Parsing an invalid SVCB or HTTPS RR can panic when the size of a parameter value overflows the message buffer."
              },
              "helpUri": "https://github.com/anchore/grype",
              "help": {
                "text": "Vulnerability GO-2026-5942\nSeverity: high\nPackage: golang.org/x/net\nVersion: v0.52.0\nFix Version: 0.56.0\nType: go-module\nLocation: /api/go.mod\nData Namespace: govulndb:language:go\nLink: [GO-2026-5942](https://go.dev/cl/786345)",
