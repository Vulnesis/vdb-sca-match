              "name": "GoModuleMatcherExactDirectMatch",
              "shortDescription": {
                "text": "GO-2026-5028 medium vulnerability for golang.org/x/net package"
              },
              "fullDescription": {
                "text": "Parsing arbitrary HTML can consume excessive CPU time, possibly leading to denial of service."
              },
              "helpUri": "https://github.com/anchore/grype",
